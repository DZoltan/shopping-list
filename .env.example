# Copy to .env for `npm run dev`. Never commit .env.

# Token for creating the first admin on /setup (any random string, 20+ characters)
NUXT_ADMIN_SETUP_TOKEN=change-me-to-a-long-random-string

# Encrypts the session cookie (32+ characters). Generated automatically on the first
# `npm run dev` if missing.
# NUXT_SESSION_PASSWORD=
