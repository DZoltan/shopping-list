{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-list",
  "compatibility_date": "2025-07-15",
  // nodejs_compat_populate_process_env: expose vars and secrets on process.env, where Nuxt's runtimeConfig reads NUXT_* overrides
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  // Per-version preview URLs are separate hostnames that Cloudflare Access on workers.dev would not cover
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopping_list",
      "database_id": "8045b3e3-30a8-4d8b-a77c-5f6b25cfc216",
      // drizzle-kit writes migrations here; wrangler applies them from the same folder
      "migrations_dir": "server/db/migrations"
    }
  ]
}
